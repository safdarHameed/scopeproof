# App
APP_NAME=ScopeProof API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database (matches docker-compose.yml at repo root)
DATABASE_URL=postgresql+asyncpg://scopeproof:scopeproof@localhost:5433/scopeproof

# Auth: generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Web app URL (used for links back into the UI)
FRONTEND_URL=http://localhost:3000

# Uploads (stored on local disk, relative to backend/)
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=25

# Engines: the placeholders keep the flow working until RAG and PayPal are connected.
ANALYZER=placeholder            # placeholder | rag
PAYMENT_PROVIDER=placeholder    # placeholder | paypal

# PayPal Sandbox (used when PAYMENT_PROVIDER=paypal)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# RAG: document content is sent to Astropods only when ANALYZER=rag.
# Never commit real API keys. Models are configurable.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
RAG_MODEL=gpt-5-6-luna
RAG_EMBEDDING_MODEL=titan-embed-text-v2
RAG_TOP_K=32
RAG_MAX_CHUNKS=150
RAG_MAX_ITEMS=20
RAG_REQUEST_TIMEOUT_SECONDS=45
RAG_TOTAL_TIMEOUT_SECONDS=240
